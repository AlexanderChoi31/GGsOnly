{% comment %}
GGs Only dedicated booking request section.
- Hero copy configurable through section settings.
- Contact form posts to Shopify contact endpoint using the 'contact' form handler.
- Collects basic player details plus scheduling preferences.
{% endcomment %}

<section class="ggs-booking-request">
  <div class="ggs-booking-wrap">
    <header class="ggs-booking-hero">
      <div class="ggs-booking-hero-text">
        <span class="ggs-booking-pill">GGs Only Coaching</span>
        <h1 class="ggs-booking-title">{{ section.settings.hero_title }}</h1>
        {% if section.settings.hero_subtitle != blank %}
          <p class="ggs-booking-subtitle">{{ section.settings.hero_subtitle }}</p>
        {% endif %}
      </div>
      <div class="ggs-booking-hero-card">
        <h3>What to expect</h3>
        <ul>
          <li>Custom improvement plan after every session</li>
          <li>Accountability check-ins between bookings</li>
          <li>Replies within 24 hours (GC1 and below)</li>
        </ul>
        {% if section.settings.hero_note != blank %}
          <p class="ggs-booking-note">{{ section.settings.hero_note }}</p>
        {% endif %}
      </div>
    </header>

    {% liquid
      assign status_class = 'ggs-booking-status'
    %}
    {% form 'contact', id: 'GGsBookingForm', class: 'ggs-booking-form' %}
      {% if form.posted_successfully? %}
        <p class="{{ status_class }} ggs-booking-status--success" tabindex="-1">
          Thanks! We’ll review your request and reply within 24 hours.
        </p>
      {% elsif form.errors %}
        <div class="{{ status_class }} ggs-booking-status--error" role="alert" tabindex="-1">
          Something went wrong. Check the highlighted fields and try again.
        </div>
      {% endif %}

      <input type="hidden" name="contact[Source]" value="GGs Only booking page">

      <div class="ggs-booking-grid">
        <label class="ggs-booking-field">
          <span>Name *</span>
          <input type="text" name="contact[name]" required placeholder="Your full name">
        </label>

        <label class="ggs-booking-field">
          <span>Email *</span>
          <input type="email" name="contact[email]" required placeholder="you@example.com">
        </label>

        <label class="ggs-booking-field">
          <span>Discord / Primary contact handle</span>
          <input type="text" name="contact[Discord]" placeholder="DiscordTag#0000 or phone">
        </label>

        <label class="ggs-booking-field">
          <span>Current rank</span>
          <input type="text" name="contact[Current rank]" placeholder="e.g. C3 Div 3">
        </label>

        <label class="ggs-booking-field ggs-booking-field--full">
          <span>Goals for coaching *</span>
          <textarea name="contact[Goals]" rows="4" required placeholder="What are you hoping to improve?"></textarea>
        </label>

        <label class="ggs-booking-field ggs-booking-field--full">
          <span>Preferred coaching times</span>
          <textarea name="contact[Preferred times]" rows="3" placeholder="Share a few days/time windows that work best."></textarea>
        </label>
      </div>

      <div class="ggs-booking-actions">
        <button type="submit" class="ggs-booking-submit">{{ section.settings.button_label }}</button>
      </div>
    {% endform %}
  </div>

  <style>
    .ggs-booking-request {
      padding: min(8vw, 72px) 0;
      background: linear-gradient(135deg, #0a144e, #030826);
      color: #f5f8ff;
    }

    .ggs-booking-wrap {
      width: min(900px, 92%);
      margin: 0 auto;
      display: grid;
      gap: 28px;
    }

    .ggs-booking-hero {
      display: grid;
      gap: 20px;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      align-items: stretch;
    }

    .ggs-booking-hero-text {
      display: grid;
      gap: 12px;
    }

    .ggs-booking-pill {
      justify-self: start;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: #99b9ff;
      font-size: 13px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      font-weight: 700;
    }

    .ggs-booking-title {
      margin: 0;
      font-size: clamp(34px, 5vw, 54px);
      letter-spacing: 0.3px;
    }

    .ggs-booking-subtitle {
      margin: 0;
      font-size: clamp(16px, 2vw, 20px);
      color: rgba(245, 248, 255, 0.85);
      line-height: 1.6;
    }

    .ggs-booking-hero-card {
      border-radius: 18px;
      background: rgba(3, 8, 38, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 20px 22px;
      display: grid;
      gap: 10px;
      box-shadow: 0 12px 30px rgba(2, 6, 30, 0.45);
    }

    .ggs-booking-hero-card h3 {
      margin: 0;
      font-size: 18px;
      letter-spacing: 0.5px;
    }

    .ggs-booking-hero-card ul {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 6px;
      font-size: 15px;
      color: rgba(245, 248, 255, 0.8);
    }

    .ggs-booking-hero-card li {
      position: relative;
      padding-left: 20px;
    }

    .ggs-booking-hero-card li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 7px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, #69b0ff, #4ea3ff);
    }

    .ggs-booking-hero-card .ggs-booking-note {
      font-size: 13px;
      color: rgba(245, 248, 255, 0.65);
      margin-top: 4px;
    }
    }

    .ggs-booking-note {
      margin: 0;
      font-size: 15px;
      color: rgba(245, 248, 255, 0.7);
    }

    .ggs-booking-form {
      background: rgba(10, 20, 78, 0.68);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      padding: 34px;
      backdrop-filter: blur(12px);
      display: grid;
      gap: 28px;
      box-shadow: 0 25px 55px rgba(1, 5, 25, 0.55);
    }

    .ggs-booking-status {
      margin: 0;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 14px;
    }

    .ggs-booking-status--success {
      background: rgba(74, 214, 152, 0.15);
      color: #9efad4;
      border: 1px solid rgba(74, 214, 152, 0.45);
    }

    .ggs-booking-status--error {
      background: rgba(255, 99, 132, 0.18);
      color: #ff99b0;
      border: 1px solid rgba(255, 99, 132, 0.4);
    }

    .ggs-booking-grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .ggs-booking-field {
      display: grid;
      gap: 8px;
      font-size: 14px;
    }

    .ggs-booking-field span {
      font-weight: 600;
      letter-spacing: 0.3px;
      color: rgba(255, 255, 255, 0.88);
    }

    .ggs-booking-field input,
    .ggs-booking-field textarea {
      width: 100%;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(3, 8, 38, 0.55);
      color: #f5f8ff;
      padding: 11px 14px;
      font-size: 15px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ggs-booking-field input:focus,
    .ggs-booking-field textarea:focus {
      outline: none;
      border-color: rgba(105, 176, 255, 0.7);
      box-shadow: 0 0 0 2px rgba(105, 176, 255, 0.2);
    }

    .ggs-booking-field textarea {
      resize: vertical;
      min-height: 110px;
    }

    .ggs-booking-field input::placeholder,
    .ggs-booking-field textarea::placeholder {
      color: rgba(245, 248, 255, 0.5);
    }

    .ggs-booking-field--full {
      grid-column: 1 / -1;
    }

    .ggs-booking-actions {
      display: flex;
      justify-content: flex-end;
    }

    .ggs-booking-submit {
      border: none;
      border-radius: 14px;
      padding: 13px 32px;
      font-size: 17px;
      font-weight: 700;
      background: linear-gradient(135deg, #9dc1ff, #4ea3ff);
      color: #041022;
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.15s ease;
      box-shadow: 0 15px 35px rgba(78, 163, 255, 0.35);
    }

    .ggs-booking-submit:hover {
      transform: translateY(-2px);
      opacity: 0.9;
    }

    @media (max-width: 640px) {
      .ggs-booking-form {
        padding: 22px;
      }

      .ggs-booking-actions {
        justify-content: center;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "GGs booking request",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "hero_title",
      "label": "Heading",
      "default": "Book your GGs Only coaching slot"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Subheading",
      "default": "Drop your details and we’ll match you with the right coach."
    },
    {
      "type": "text",
      "id": "hero_note",
      "label": "Supporting note",
      "default": "Average reply time: under 24 hours."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Request session"
    }
  ],
  "presets": [
    {
      "name": "GGs booking request"
    }
  ]
}
{% endschema %}
