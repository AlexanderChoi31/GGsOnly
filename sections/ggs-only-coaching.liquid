{% comment %}
GGs Only Coaching section
- Dark blue gradient hero
- Age focus callout (18–23 default)
- Two offer cards (default pricing $20 and $35 per hour)
- Grand Champion 2 percentile marker
- Optional contact form for inquiries (no payments processed here)
{% endcomment %}

{% liquid
  assign default_percentile = 0.6
  assign raw_percentile = section.settings.gc_percentile
  if raw_percentile == blank
    assign pct_value = default_percentile
  else
    assign pct_value = raw_percentile
  endif
  assign pct_value = pct_value | plus: 0
  if pct_value < 0
    assign pct_value = 0
  endif
  if pct_value > 100
    assign pct_value = 100
  endif
%}

<section class="ggs-only-coaching">
  <div class="ggs-only-wrap">
    <header class="ggs-only-hero">
      {% if section.settings.age_range != blank %}
        <span class="ggs-only-age">Age focus {{ section.settings.age_range }}</span>
      {% endif %}
      <h1 class="ggs-only-title">{{ section.settings.shop_title | default: 'GGs Only' }}</h1>
      <p class="ggs-only-subtitle">{{ section.settings.subtitle | default: 'Rocket League coaching for 18–23 year olds' }}</p>
    </header>

    <div class="ggs-only-offers">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'offer' %}
            <article class="ggs-only-card" {{ block.shopify_attributes }}>
              <div class="ggs-only-card-body">
                <h3 class="ggs-only-card-title">{{ block.settings.title }}</h3>
                <p class="ggs-only-card-desc">{{ block.settings.desc }}</p>
                {% if block.settings.price != blank %}
                  <div class="ggs-only-price">
                    ${{ block.settings.price }}
                    <span class="ggs-only-price-unit">/ hr</span>
                  </div>
                {% endif %}
                {% liquid
                  assign cta_label = block.settings.cta_label | default: 'Book a session'
                  assign cta_url = block.settings.cta_url
                %}
                {% if cta_url != blank %}
                  <a class="ggs-only-btn" href="{{ cta_url }}">{{ cta_label }}</a>
                {% else %}
                  <a class="ggs-only-btn" href="#ggs-only-contact">{{ cta_label }}</a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      {% else %}
        <article class="ggs-only-card">
          <div class="ggs-only-card-body">
            <h3 class="ggs-only-card-title">Basic Training</h3>
            <p class="ggs-only-card-desc">Fundamentals, mechanics check, and focused drills to level up consistency.</p>
            <div class="ggs-only-price">$20 <span class="ggs-only-price-unit">/ hr</span></div>
            <a class="ggs-only-btn" href="#ggs-only-contact">Book a session</a>
          </div>
        </article>
        <article class="ggs-only-card">
          <div class="ggs-only-card-body">
            <h3 class="ggs-only-card-title">Advanced Coaching</h3>
            <p class="ggs-only-card-desc">Replay analysis, rotations, and detailed training packs tailored to your goals.</p>
            <div class="ggs-only-price">$35 <span class="ggs-only-price-unit">/ hr</span></div>
            <a class="ggs-only-btn" href="#ggs-only-contact">Book a session</a>
          </div>
        </article>
      {% endif %}
    </div>

    <section class="ggs-only-stats">
      <h2 class="ggs-only-stats-title">Where {{ section.settings.gc_rank | default: 'Grand Champion 2' }} sits</h2>
      <p class="ggs-only-stats-sub">Approximate percentile placement (adjust in settings).</p>
      <div class="ggs-only-bar">
        <div class="ggs-only-bar-fill"></div>
        <span class="ggs-only-marker" style="left: {{ pct_value }}%;" aria-label="Top {{ pct_value }} percent"></span>
      </div>
      <div class="ggs-only-bar-label">
        {{ section.settings.gc_rank | default: 'GC2' }} &asymp; Top {{ pct_value }}%
      </div>
      <p class="ggs-only-stats-note">Percentile is for illustration. Update with your official figures or personal stats.</p>
    </section>

    {% if section.settings.show_contact %}
      <section id="ggs-only-contact" class="ggs-only-contact">
        <div class="ggs-only-contact-inner">
          <h2 class="ggs-only-contact-title">Contact &amp; Booking</h2>
          <p class="ggs-only-contact-copy">Have questions or ready to schedule time? Send a message and we will respond shortly.</p>
          {% form 'contact', id: 'GGsOnlyContactForm' %}
            <div class="ggs-only-form-grid">
              <input type="text" id="GGsOnlyContactName" name="contact[name]" placeholder="Your name" required>
              <input type="email" id="GGsOnlyContactEmail" name="contact[email]" placeholder="Your email" required>
              <input type="text" id="GGsOnlyContactAge" name="contact[age]" placeholder="Age ({{ section.settings.age_range | default: '18–23' }})">
              <textarea id="GGsOnlyContactMessage" name="contact[body]" rows="4" placeholder="Tell us your rank, goals, or preferred schedule"></textarea>
            </div>
            <button type="submit" class="ggs-only-btn ggs-only-btn-outline">Send</button>
          {% endform %}
        </div>
      </section>
    {% endif %}
  </div>

  <style>
    .ggs-only-coaching {
      --bg-top: #405bff;
      --bg-bottom: #000e6b;
      --text-base: #ffffff;
      --text-muted: #d6dcff;
      --accent: #8db4ff;
      --card-bg: rgba(0, 14, 107, 0.5);
      --card-border: rgba(255, 255, 255, 0.18);
      --btn-bg: #69b0ff;
      padding: min(6vw, 64px) 0;
      background: linear-gradient(135deg, var(--bg-top), var(--bg-bottom));
      color: var(--text-base);
    }

    .ggs-only-wrap {
      width: min(1080px, 92%);
      margin: 0 auto;
    }

    .ggs-only-hero {
      text-align: center;
      display: grid;
      gap: 12px;
      margin-bottom: 32px;
    }

    .ggs-only-age {
      display: inline-block;
      align-self: center;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(90, 169, 255, 0.15);
      color: var(--accent);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .ggs-only-title {
      margin: 0;
      font-size: clamp(32px, 6vw, 58px);
      letter-spacing: 0.4px;
      line-height: 1.05;
    }

    .ggs-only-subtitle {
      margin: 0;
      font-size: clamp(16px, 2.2vw, 20px);
      color: var(--text-muted);
    }

    .ggs-only-offers {
      display: grid;
      gap: 20px;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      margin-bottom: 38px;
    }

    .ggs-only-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      overflow: hidden;
      backdrop-filter: blur(8px);
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .ggs-only-card:hover {
      transform: translateY(-4px);
      border-color: rgba(149, 174, 215, 0.4);
    }

    .ggs-only-card-body {
      padding: 22px;
      display: grid;
      gap: 12px;
    }

    .ggs-only-card-title {
      margin: 0;
      font-size: 22px;
    }

    .ggs-only-card-desc {
      margin: 0;
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.6;
    }

    .ggs-only-price {
      font-size: 30px;
      font-weight: 700;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .ggs-only-price-unit {
      font-size: 14px;
      font-weight: 400;
      color: var(--text-muted);
    }

    .ggs-only-btn {
      display: inline-block;
      padding: 11px 18px;
      border-radius: 14px;
      background: var(--btn-bg);
      color: #041022;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.18s ease, opacity 0.18s ease;
    }

    .ggs-only-btn:hover {
      transform: translateY(-2px);
      opacity: 0.92;
    }

    .ggs-only-btn-outline {
      margin-top: 14px;
      background: transparent;
      color: var(--text-base);
      border: 1px solid var(--card-border);
    }

    .ggs-only-stats {
      text-align: center;
      display: grid;
      gap: 12px;
      margin-bottom: 44px;
    }

    .ggs-only-stats-title {
      margin: 0;
      font-size: 24px;
    }

    .ggs-only-stats-sub {
      margin: 0;
      color: var(--text-muted);
      font-size: 15px;
    }

    .ggs-only-bar {
      position: relative;
      width: min(720px, 92%);
      margin: 0 auto;
      height: 12px;
      border-radius: 999px;
      border: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .ggs-only-bar-fill {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(90, 169, 255, 0.3), rgba(105, 176, 255, 0.05));
    }

    .ggs-only-marker {
      position: absolute;
      top: -5px;
      width: 2px;
      height: 22px;
      background: var(--accent);
      border-radius: 1px;
      box-shadow: 0 0 0 4px rgba(105, 176, 255, 0.25);
    }

    .ggs-only-bar-label {
      font-weight: 600;
    }

    .ggs-only-stats-note {
      margin: 0;
      font-size: 13px;
      color: var(--text-muted);
    }

    .ggs-only-contact {
      margin-top: 32px;
      background: rgba(12, 27, 52, 0.75);
      border: 1px solid var(--card-border);
      border-radius: 22px;
      padding: 24px;
      backdrop-filter: blur(10px);
    }

    .ggs-only-contact-inner {
      display: grid;
      gap: 16px;
    }

    .ggs-only-contact-title {
      margin: 0;
      font-size: 24px;
    }

    .ggs-only-contact-copy {
      margin: 0;
      color: var(--text-muted);
    }

    .ggs-only-form-grid {
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .ggs-only-form-grid input,
    .ggs-only-form-grid textarea {
      width: 100%;
      border-radius: 12px;
      border: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-base);
      padding: 12px 14px;
    }

    .ggs-only-form-grid input::placeholder,
    .ggs-only-form-grid textarea::placeholder {
      color: var(--text-muted);
    }

    @media (max-width: 600px) {
      .ggs-only-card-body {
        padding: 18px;
      }

      .ggs-only-price {
        font-size: 26px;
      }

      .ggs-only-contact {
        padding: 20px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "GGs Only Coaching",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "shop_title",
      "label": "Hero title",
      "default": "GGs Only"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Hero subtitle",
      "default": "Rocket League coaching for 18–23 year olds"
    },
    {
      "type": "text",
      "id": "age_range",
      "label": "Age focus label",
      "default": "18–23"
    },
    {
      "type": "text",
      "id": "gc_rank",
      "label": "Featured rank label",
      "default": "Grand Champion 2"
    },
    {
      "type": "number",
      "id": "gc_percentile",
      "label": "Percentile (Top X%)",
      "info": "Enter a number between 0 and 100. Leave blank to show 0.6 by default."
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact form",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer card",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Basic Training"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Fundamentals, mechanics check, and focused drills for consistent growth."
        },
        {
          "type": "number",
          "id": "price",
          "label": "Price (USD/hour)",
          "default": 20
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL (optional)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Book a session"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GGs Only Coaching",
      "blocks": [
        {
          "type": "offer",
          "settings": {
            "title": "Basic Training",
            "desc": "Fundamentals, mechanics check, and focused drills for consistent growth.",
            "price": 20,
            "cta_label": "Book a session"
          }
        },
        {
          "type": "offer",
          "settings": {
            "title": "Advanced Coaching",
            "desc": "Replay analysis, rotations, and game-sense coaching tailored to your climb.",
            "price": 35,
            "cta_label": "Book a session"
          }
        }
      ]
    }
  ]
}
{% endschema %}
